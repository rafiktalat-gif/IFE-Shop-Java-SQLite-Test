<?xml version="1.0" encoding="utf-8"?>
<widget id="com.ife.shop" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>IFE Shop SQLite Test</name>
    <description>Test native Android Java SQLite persistence from Cordova JavaScript.</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="AndroidXEnabled" value="true" />
    </platform>
</widget>
